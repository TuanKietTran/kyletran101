{
  "name": "kyletrancms",
  "private": true,
  "scripts": {
    "start": "turbo run start",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "dev:content": "turbo run dev --filter=content",
    "dev:web": "turbo run dev --filter=web",
    "build:content": "turbo run build --filter=content",
    "build:web": "turbo run build --filter=web",
    "start:content": "turbo run start --filter=content",
    "start:web": "turbo run start --filter=web",
    "lint:content": "turbo run lint --filter=content",
    "lint:web": "turbo run lint --filter=web"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.1.2",
    "pg": "8.8.0"
  },
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
